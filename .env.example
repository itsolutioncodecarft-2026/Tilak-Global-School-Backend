PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/tilak_school
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# CORS — comma-separated allowed origins
# Dev:
CLIENT_URL=http://localhost:3000,http://localhost:3001
# Production (set on Render dashboard):
# CLIENT_URL=https://tilakglobalschool.com,https://admin-portal.tilakglobalschool.com

# Cookie domain — scopes cookie to all subdomains in production
# Dev: leave blank (host-only)
COOKIE_DOMAIN=
# Production: .tilakglobalschool.com

# Render keep-alive ping URL
RENDER_URL=https://api.tilakglobalschool.com

# Admin seed credentials
ADMIN_EMAIL=admin@tilakglobalschool.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Super Admin
